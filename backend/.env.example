# =============================================================================
# CommitDrive Backend — Supabase PostgreSQL Environment Variables
# Copy to .env and configure with your Supabase project credentials.
# =============================================================================

# Active Spring Profile (set to 'supabase' for live Supabase, 'local' for H2)
SPRING_PROFILES_ACTIVE=supabase

# 1. Supabase Direct Database Connection URL (from Project Settings -> Database)
# Format: jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# 2. Or Supabase Transaction Pooler (port 6543, recommended for IPv4 and serverless)
# Format: jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase DB User (default: postgres)
SUPABASE_DB_USER=postgres

# Supabase DB Password (set during project creation)
SUPABASE_DB_PASSWORD=your_supabase_password_here

# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration (at least 256 bits / 32 chars)
COMMITDRIVE_JWT_SECRET=your_jwt_secret_key_here_must_be_secure
commitdrive.jwt.secret=your_jwt_secret_key_here_must_be_secure
